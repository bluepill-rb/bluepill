module Bluepill
  # The parts of the daemons gem that bluepill uses
  module Daemonize
    class Error < RuntimeError
    end

    MAX_FD: Integer

    def self.safefork: () -> Integer?

    def self.call_as_daemon: (^() -> void block, ?String? name) -> Integer

    def self.read_daemon_pid: (Integer intermediate, IO reader, IO writer) -> Integer

    def self.run_daemon: (^() -> void block, String? name, IO writer) -> bot

    def self.daemonize: () -> Integer

    def self.detach: () -> Integer

    def self.become_daemon: (?String? name) -> void

    def self.close_io: () -> void

    def self.close_fds: () -> void

    def self.redirect_io: () -> void

    def self.quietly: () { () -> void } -> void
  end

  # Memoizes ps output for a tick, and runs commands as daemons or until
  # they finish
  module System
    extend Ps
    extend Usage
    extend Files
    extend Commands
    extend Daemon

    # What the child that runs a command sends its parent
    type blocking_result = { exit_code: Integer?, stdout: String, stderr: String }

    # How a command runs, for daemonize and execute_blocking
    class CommandOptions
      attr_reader uid: String?
      attr_reader gid: String?
      attr_reader supplementary_groups: Array[String]?
      attr_reader working_dir: String?
      attr_reader environment: Hash[_ToS, _ToS]
      attr_reader stdin: String?
      attr_reader stdout: String?
      attr_reader stderr: String?
      # Hooks are killed after this many seconds
      attr_reader timeout: seconds?

      def initialize: (
        ?uid: String?,
        ?gid: String?,
        ?supplementary_groups: Array[String]?,
        ?working_dir: String?,
        ?environment: Hash[_ToS, _ToS]?,
        ?stdin: String?,
        ?stdout: String?,
        ?stderr: String?,
        ?timeout: seconds?
      ) -> void

      def for_hook: (Hash[String, String] env, seconds timeout) -> CommandOptions

      def to_h: () -> {
        uid: String?,
        gid: String?,
        supplementary_groups: Array[String]?,
        working_dir: String?,
        environment: Hash[_ToS, _ToS]?,
        stdin: String?,
        stdout: String?,
        stderr: String?,
        timeout: seconds?
      }
    end

    # What a command that ran until it finished printed, and how it exited
    class CommandResult
      def self.from_h: (blocking_result result) -> CommandResult

      attr_reader exit_code: Integer?
      attr_reader stdout: String
      attr_reader stderr: String

      def initialize: (exit_code: Integer?, ?stdout: String, ?stderr: String) -> void

      def success?: () -> bool

      def to_h: () -> blocking_result
    end

    type grandchild_pipes = { out: [IO, IO], err: [IO, IO], result: IO }

    APPEND_MODE: String

    PS_MUTEX: Thread::Mutex

    NO_PIDS: Array[Integer]

    # Raised when ps could not be run, so there is no data for this tick
    class PsError < StandardError
    end

    # A tick's table of processes, as ps listed them
    class PsTable
      PID: Integer
      PPID: Integer
      PCPU: Integer
      RSS: Integer
      ETIME: Integer
      COMMAND: Integer

      @rows: Hash[Integer, Array[String]]
      @children_by_parent: Hash[Integer, Array[Integer]]?

      def self.parse: (String output) -> PsTable

      attr_reader rows: Hash[Integer, Array[String]]

      def initialize: (Hash[Integer, Array[String]] rows) -> void

      def row: (Integer? pid) -> Array[String]?

      def children: (Integer? pid) -> Array[Integer]

      # The pid must be above 0
      def descendants: (Integer? pid) -> Array[Integer]

      # Adds the column to total, which starts at 0.0
      def sum: (Array[Integer] pids, Integer column, ?Float total) -> Float

      private

      def children_by_parent: () -> Hash[Integer, Array[Integer]]
    end

    # Runs ps once a tick, and reads its table of processes
    module Ps
      # The table lives on System, which extends this module, or why ps
      # could not be run this tick
      @ps_table: PsTable | PsError | nil
      # The table get_children read this tick
      @children_table: PsTable?

      def reset_data: () -> void

      def ps_axu: () -> PsTable

      def read_ps_table: () -> (PsTable | PsError)

      def get_children: (Integer? parent_pid) -> Array[Integer]
    end

    # Asks the system about a process
    module Usage : Ps
      def pid_alive?: (Integer pid) -> bool

      def started_at: (Integer pid) -> Integer?

      def boot_time: () -> Integer?

      def cpu_usage: (Integer? pid, boolish include_children) -> Float?

      def memory_usage: (Integer? pid, boolish include_children) -> Float?

      def usage: (Integer? pid, boolish include_children, Integer column) -> Float?

      def running_time: (Integer? pid) -> Integer?

      def command: (Integer? pid) -> String?

      def parse_elapsed_time: (String? str) -> Integer
    end

    # Deletes the files that bluepill leaves behind
    module Files
      def delete_if_exists: (String? filename) -> void
    end

    # Sets up the process that a command runs in
    module CommandSetup
      def setup_command_environment: (CommandOptions options) -> void

      def drop_privileges: (String? uid, String? gid, Array[String]? supplementary_groups) -> void

      def join_groups: (Etc::Passwd? user, Integer? gid_num) -> Integer?

      def add_supplementary_groups: (Array[String]? supplementary_groups) -> void

      def switch_to_user: (Etc::Passwd user) -> void
    end

    # Runs commands in the background, as daemons
    module Daemon
      include CommandSetup

      # Returns the daemon's pid
      def daemonize: (String cmd, ?CommandOptions options, pid_file: String, logger: Logger) -> Integer?

      def read_daemon_pid: (IO reader, IO writer) -> Integer?

      def start_daemon: (String cmd, CommandOptions options, IO pid_pipe, pid_file: String, logger: Logger) -> bot

      def daemon_command: (String cmd, CommandOptions options) -> ^() -> void

      def can_write_pid_file: (String pid_file, Logger logger) -> bool

      def redirect_io: (String? io_in, String? io_out, String? io_err) -> void
    end

    # Runs commands until they finish
    module Commands
      include CommandSetup

      def execute_blocking: (String cmd, ?CommandOptions options) -> CommandResult

      def start_blocking_child: (String cmd, CommandOptions options, IO reader, IO result_pipe) -> bot

      def read_blocking_status: (String cmd, seconds? timeout, Integer child, IO reader) -> String

      def kill_group_after: (Integer child, seconds? timeout, String cmd) -> bot

      def run_blocking_child: (String cmd, CommandOptions options, IO result_pipe) -> bot

      def collect_blocking_result: (Integer pid, IO cmd_out_read, IO cmd_err_read) -> blocking_result

      def report_blocking_result: (IO result_pipe, blocking_result result) -> bot

      def exec_blocking_grandchild: (String cmd, CommandOptions options, grandchild_pipes pipes) -> bot

      def reopen_on_pipe: (IO stream, [IO, IO] pipe) -> void

      def report_grandchild_error: (Exception error, grandchild_pipes pipes) -> bot
    end
  end

  # Remembers the pids and process groups of the processes bluepill starts,
  # so it can kill any left over from an earlier run
  module ProcessJournal
    extend Config
    extend Entries
    extend Cleanup
    extend Lock

    # What a journal holds: pids, or process group ids
    class Kind
      @file_tag: String

      attr_reader name: String
      attr_reader label: String
      attr_reader sign: Integer

      def initialize: (String name, String label, String file_tag, Integer sign) -> void

      def filename: (String dir, _ToS journal_name) -> String
    end

    PID: Kind

    PGID: Kind

    # Raised when another process holds a journal's lock for too long
    class LockTimeoutError < StandardError
    end

    # A process's pid journal and process group journal
    class Journal
      @name: _ToS

      attr_reader name: _ToS

      def initialize: (_ToS name) -> void

      def append: (Integer? pid) -> void

      def kill_all: () -> void

      private

      def append_process_group: (Integer pid) -> void
    end

    # What the modules that ProcessJournal extends use from it
    interface _Journal
      def logger: () -> Logger

      def journal_base_dir: () -> String

      def legacy_journal_dir: () -> String

      def journal_dirs: () -> Array[String]

      def journal_entries: (String filename) -> Array[[Integer, Integer?]]

      def journal_ids: (Kind kind, String filename) -> Array[Integer]
    end

    # Where the journals are, and the logger they write to
    module Config
      @logger: Logger
      @journal_base_dir: String
      @legacy_journal_dir: String

      attr_reader logger: Logger

      attr_reader journal_base_dir: String

      attr_reader legacy_journal_dir: String

      # Only the first logger is kept
      def logger=: (Logger new_logger) -> Logger

      def setup: (String base_dir, _ToS app_name) -> void

      def journal_dirs: () -> Array[String]
    end

    # Reads and writes the ids in a process's journals
    module Entries : _Journal, Lock
      def for: (_ToS name) -> Journal

      def skip_id?: (Integer? id) -> bool

      # Each id, with when its process started (nil before 0.2)
      def journal_entries: (String filename) -> Array[[Integer, Integer?]]

      def journal_line: (Integer id) -> String

      def journal_ids: (Kind kind, String filename) -> Array[Integer]

      def append: (Kind kind, _ToS journal_name, Integer? id) ?{ (Integer id) -> void } -> void

      def write_to_journal: (String filename, _ToS journal_name, String name, Integer id) { () -> Array[Integer] } -> void
    end

    # Kills what an earlier run left in a process's journals
    module Cleanup : _Journal, Lock
      def kill_all: (Kind kind, _ToS journal_name) -> void

      def kill_all_from_journal_file: (String filename, Array[Integer] ids, Kind kind) -> void

      def term_then_kill_journaled: (Array[Integer] ids, Kind kind) -> void

      def journaled_ids: (String filename, Array[Integer] ids, Kind kind) -> Array[Integer]

      def same_journaled_process?: (Integer id, Integer? journaled, Integer? boot, Integer written) -> bool

      def signal_journaled: (String signal, Array[Integer] ids, Kind kind) -> void
    end

    # Locks a journal while bluepill reads and writes it
    module Lock : _Journal
      def acquire_atomic_fs_lock: [T] (String name) { () -> T } -> T

      def clear_all_atomic_fs_locks: () -> void

      def clear_atomic_fs_lock: (String name) -> void

      def make_atomic_fs_lock: (String lock) -> void

      def wait_for_atomic_fs_lock: (String lock, Integer attempts) -> void
    end
  end
end
