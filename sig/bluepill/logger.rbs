module Bluepill
  # Logs to a file or syslog, with nested prefixes
  class Logger
    # Where a Logger without a parent logger writes: a LoggerAdapter, or
    # Syslog
    interface _Backend
      def emerg: (String message) -> void

      def alert: (String message) -> void

      def crit: (String message) -> void

      def err: (String message) -> void

      def warning: (String message) -> void

      def notice: (String message) -> void

      def info: (String message) -> void

      def debug: (String message) -> void
    end

    LOG_METHODS: Array[Symbol]

    # A ::Logger that also answers to the syslog method names
    class LoggerAdapter < ::Logger
      LOGGER_EQUIVALENTS: Hash[Symbol, Symbol]

      alias err error

      alias warning warn

      alias emerg fatal

      alias alert warn

      alias crit fatal

      alias notice info
    end

    @log_file: String?
    @identity: String
    @level: Integer
    @stdout: bool
    @names: Array[String?]
    @label: String?
    # A one-element box that every logger made from the same one shares
    @sink: Array[Object & _Backend]
    @prefixes: Hash[String?, Logger]

    def initialize: (?logger: (Object & _Backend)?, ?stdout: bool, ?log_file: String?, ?identity: String, ?log_level: Symbol | String) -> void

    def emerg: (_ToS msg) -> void

    def alert: (_ToS msg) -> void

    def crit: (_ToS msg) -> void

    def err: (_ToS msg) -> void

    def warning: (_ToS msg) -> void

    def notice: (_ToS msg) -> void

    def info: (_ToS msg) -> void

    def debug: (_ToS msg) -> void

    def prefix_with: (String? prefix) -> Logger

    def reopen: () -> void

    # Protected in Ruby, and called on a copy, so public here
    def add_prefix: (String? prefix) -> Logger

    private

    def label: (Array[String?] names) -> String?

    def priority: (Symbol | String level) -> Integer

    def create_logger: () -> (Object & _Backend)

    def require_syslog: () -> void
  end
end
