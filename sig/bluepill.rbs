# Type signatures for bluepill

module Bluepill
  # A time in seconds. An ActiveSupport::Duration also works, since it
  # passes for its value.
  type seconds = Integer | Float

  # A process block from the config, which runs with self set to the
  # ProcessProxy and also gets it as an argument
  type process_block = ^(ProcessProxy process) [self: ProcessProxy] -> void

  # Sets up Bundler when bluepill runs with a Gemfile, such as under bundle
  # exec
  def self.setup_bundler: (?String? gemfile) -> void

  # Loads an application from a config file. The block runs with self set to
  # the AppProxy, and also gets it as an argument.
  def self.application: (_ToS app_name, *Hash[Symbol, untyped] args) { (AppProxy app) [self: AppProxy] -> void } -> void

  module Version
    def self.major: () -> Integer

    def self.minor: () -> Integer

    def self.patch: () -> Integer

    def self.pre: () -> Integer?

    def self.to_h: () -> { major: Integer, minor: Integer, patch: Integer, pre: Integer? }

    def self.to_a: () -> Array[Integer]

    def self.to_s: () -> String
  end

  # The monotonic clock that times ticks, checks and grace times
  module Clock
    def self.now: () -> Integer
  end

  # What a process passes to its transition callbacks and triggers
  interface _Transition
    def from_name: () -> Symbol?

    def to_name: () -> Symbol?

    def loopback?: () -> bool
  end

  # The durations and sizes a config writes, as plain numbers of seconds
  # and bytes. Numeric includes it, so its own methods come first.
  # What Units needs of the number it's in
  interface _Multipliable
    def *: (Integer) -> Numeric
  end

  module Units : _Multipliable
    MINUTE: Integer
    HOUR: Integer
    DAY: Integer
    KILOBYTE: Integer
    MEGABYTE: Integer
    GIGABYTE: Integer

    def seconds: () -> self
    alias second seconds

    def minutes: () -> Numeric
    alias minute minutes

    def hours: () -> Numeric
    alias hour hours

    def days: () -> Numeric
    alias day days

    def kilobytes: () -> Numeric
    alias kilobyte kilobytes

    def megabytes: () -> Numeric
    alias megabyte megabytes

    def gigabytes: () -> Numeric
    alias gigabyte gigabytes
  end

  module Util
    # Turns a snake_case name into CamelCase, as ActiveSupport's camelize
    # does
    def self.camelize: (_ToS name) -> String

    # Turns a CamelCase name into snake_case, as ActiveSupport's underscore
    # does
    def self.underscore: (String name) -> String

    # Logs an error at err, with a line for each backtrace line
    def self.log_error: (Logger logger, String summary, Exception error) -> void

    # An array that drops its oldest element when it grows past its capacity
    class RotationalArray[Elem] < Array[Elem]
      @capacity: Integer

      def initialize: (Integer size) -> void

      def push: (Elem value) -> self

      alias << push
    end
  end
end

# Numeric includes Units, so these do. Numeric itself has no * to type it
# with.
class Integer
  include Bluepill::Units
end

class Float
  include Bluepill::Units
end
