# Only what bluepill uses from state_machine, which has no signatures
module StateMachine
  type state_key = Symbol | Array[Symbol] | Matcher
  type transition_option = Symbol | Matcher

  class Matcher
  end

  class AllMatcher < Matcher
  end

  module MatcherHelpers
    def any: () -> AllMatcher
  end

  class Event
    include MatcherHelpers

    def transition: (Hash[state_key, transition_option] options) -> void
  end

  class Machine
    include MatcherHelpers

    def state: (*Symbol names) -> void

    def event: (*Symbol names) { () [self: Event] -> void } -> void

    def before_transition: (Hash[state_key, transition_option] options) -> void

    def after_transition: (Hash[state_key, transition_option] options) -> void
  end

  class Transition
    def from_name: () -> Symbol?

    def to_name: () -> Symbol?

    def loopback?: () -> bool
  end

  module MacroMethods
    def state_machine: (?Hash[Symbol, untyped] options) ?{ () [self: Machine] -> void } -> Machine
  end
end

class Class
  include StateMachine::MacroMethods
end
