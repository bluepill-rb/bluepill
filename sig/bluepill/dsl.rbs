module Bluepill
  # The parts the application and process blocks share
  module DSL
    # The attributes a pill file sets with `name = value`. The writers and
    # readers are defined at load, and an unknown name raises ConfigError.
    module Attributes : _Owner
      # What Attributes uses from the class that includes it
      interface _Owner
        def attribute_owner: () -> String

        # The class, which extends ClassMethods
        def class: () -> ClassMethods
      end

      def self.included: (Module base) -> void

      # The attribute macro
      module ClassMethods : Module
        @attribute_names: Array[Symbol]

        attr_reader attribute_names: Array[Symbol]

        def attribute: (*Symbol names) -> void
      end

      @attributes: Hash[Symbol, untyped]

      attr_reader attributes: Hash[Symbol, untyped]

      private

      def method_missing: (Symbol name, *untyped) -> bot

      def respond_to_missing?: (Symbol name, bool include_private) -> false

      def suggest: (String attribute) -> String?
    end
  end

  # self in an application block
  class AppProxy
    include DSL::Attributes
    extend DSL::Attributes::ClassMethods

    def working_dir: () -> String?
    def working_dir=: (String? value) -> String?
    def uid: () -> String?
    def uid=: (String? value) -> String?
    def gid: () -> String?
    def gid=: (String? value) -> String?
    def supplementary_groups: () -> Array[String]?
    def supplementary_groups=: (Array[String]? value) -> Array[String]?
    def environment: () -> Hash[_ToS, _ToS]?
    def environment=: (Hash[_ToS, _ToS]? value) -> Hash[_ToS, _ToS]?
    def auto_start: () -> bool?
    def auto_start=: (bool? value) -> bool?
    def notify_command: () -> String?
    def notify_command=: (String? value) -> String?

    attr_reader app: Application

    @name: String
    @registry: ProcessFactory::Registry

    def initialize: (_ToS app_name, **untyped options) -> void

    # The block runs with self set to the ProcessProxy, and also gets it as
    # an argument
    def process: (String process_name) { (ProcessProxy process) [self: ProcessProxy] -> void } -> Array[Process]

    def attribute_owner: () -> String
  end

  # Builds processes from a process block in the config
  class ProcessFactory
    @attributes: Hash[Symbol, untyped]
    @process_block: process_block
    @registry: Registry

    def initialize: (Hash[Symbol, untyped] attributes, process_block process_block, ?Registry registry) -> void

    # The process, and the group its block set
    def create_process: (String name, String pids_dir) -> [Process, untyped]

    private

    def default_pid_file: (String process_name, String pids_dir) -> String

    def children_attributes: (ProcessProxy process) -> Hash[Symbol, untyped]

    def validate_process!: (ProcessProxy process) -> void

    def validate_unique_process!: (ProcessProxy process) -> void

    def validate_required_attributes!: (ProcessProxy process) -> void

    def validate_unique_pid_file!: (ProcessProxy process) -> void

    def validate_stop_signals!: (ProcessProxy process) -> void

    def validate_stop_signal_order!: (Array[Symbol | Integer] stop_signals) -> void

    def validate_stop_grace_time!: (Array[Symbol | Integer] stop_signals, Integer? stop_grace_time) -> void

    def warn_unless_pid_known: (ProcessProxy process, String default_pid_file) -> void

    def config_error!: (String message) -> bot

    # The process names and pid files an application's config has used
    class Registry
      @process_keys: Set[[String?, String]]
      @pid_files: Set[String]

      def initialize: () -> void

      def add_process?: (_ToS? group, _ToS name) -> bool

      def add_pid_file?: (String pid_file) -> bool
    end

    # Creates the processes of a process's children, and checks their
    # block when it's made
    class ChildFactory
      @attributes: Hash[Symbol, untyped]
      @child_process_block: process_block

      def initialize: (String parent_name, Hash[Symbol, untyped] parent_attributes, process_block child_process_block) -> void

      def create_child_process: (String name, Integer pid, Logger logger) -> Process

      private

      def validate!: (String parent_name) -> void
    end
  end

  # self in a process block. Each attribute is set with `name = value`
  # and read back with `name`. The writers and readers are defined at load,
  # from Process::CONFIGURABLE_ATTRIBUTES, so they aren't listed here.
  class ProcessProxy
    include DSL::Attributes
    extend DSL::Attributes::ClassMethods

    attr_reader name: String
    attr_reader child_process_block: process_block?
    attr_reader actual_pid: Integer?

    # The checks the block added, in order, with their options
    @checks: Array[[Symbol, Hash[Symbol, untyped]]]

    def initialize: (String process_name, Hash[Symbol, untyped] attributes, process_block process_block, ?actual_pid: Integer?) -> void

    # The readers of the attributes the factory uses
    def group: () -> untyped
    def pid_file: () -> String?
    def stop_command: () -> String?

    def checks: (Symbol name, **untyped options) -> nil

    # The block configures the children like a process block
    def monitor_children: () ?{ (ProcessProxy child) [self: ProcessProxy] -> void } -> process_block

    def to_process: (**untyped options) -> Process

    def attribute_owner: () -> String
  end
end
