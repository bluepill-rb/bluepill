module Bluepill
  # A monitored process
  class Process
    # The checks a process is made with: each check's name and options, as
    # a Hash or as a list of pairs, which can name a check twice
    type checks = _Each[[Symbol, Hash[Symbol, untyped]]]

    include ProcessCommands
    include Attributes
    include Pid
    include Children
    include StateMachine
    include TransitionCallbacks
    include UserCommands

    attr_accessor name: String
    attr_reader watches: Process::Watches
    attr_reader triggers: Process::Triggers
    attr_accessor skip_ticks_until: Integer?
    attr_accessor process_running: bool?

    attr_reader children: Array[Process]
    attr_reader statistics: ProcessStatistics
    attr_reader logger: Logger

    @event_mutex: Monitor
    @threads: Array[Thread]
    @actual_pid: Integer?
    @transition_reason: String?
    @transitioned: bool

    attr_accessor app_name: String?
    attr_accessor group_name: String?

    # A process's move from one state to another
    class Transition
      attr_reader from_name: Symbol
      attr_reader to_name: Symbol

      def initialize: (Symbol from_name, Symbol to_name) -> void

      def loopback?: () -> bool
    end

    # Methods bluepill defines

    def initialize: (String process_name, checks checks, ?logger: untyped, ?actual_pid: Integer?, **untyped attributes) -> void

    # Runs the state machine's tick event, then the watches and children
    def tick: () -> void

    def tick_children: () -> void

    def dispatch!: (Symbol event, ?String? reason) -> bool

    def add_checks: (checks checks, Logger logger) -> void

    def add_check: (Symbol name, Hash[Symbol, untyped] options) -> void

    # Runs the watches that are due, and dispatches their events
    def run_watches: () -> void

    def clean_threads: () -> void

    def daemonize?: () -> bool

    def skip_ticks_for: (seconds seconds) -> Integer

    def skipping_ticks?: () -> bool?
  end

  # Moves a Process between its states
  module Process::StateMachine : Process::StateMachine::_Host
    # What StateMachine uses from Process
    interface _Host
      %a{pure} def auto_start: () -> bool?
      def process_running?: (?bool force) -> bool
      def before_transition: (Process::Transition transition) -> true
      def after_transition: (Process::Transition transition) -> void
    end

    TICKS: Hash[Symbol, Array[Symbol]]

    TRANSITIONS: Hash[Symbol, Hash[Symbol, Symbol]]

    STATES: Array[Symbol]

    LOOPBACKS: Hash[Symbol, Process::Transition]

    attr_accessor state: Symbol

    def unmonitored?: () -> bool

    def up?: () -> bool

    def down?: () -> bool

    def starting?: () -> bool

    def stopping?: () -> bool

    def restarting?: () -> bool

    # Moves the process to the state an event leads to, and returns whether
    # it moved
    def fire_event: (Symbol event) -> bool

    def tick_target: (Symbol from) -> Symbol?

    def determine_initial_state: () -> void
  end

  # Runs what a Process does on its way from one state to another
  module Process::TransitionCallbacks : Process::TransitionCallbacks::_Host
    # What TransitionCallbacks uses from Process
    interface _Host
      %a{pure} def logger: () -> Logger
      %a{pure} def watches: () -> Process::Watches
      %a{pure} def triggers: () -> Process::Triggers
      %a{pure} def children: () -> Array[Process]
      def monitor_children?: () -> bool
      def clean_threads: () -> void
      def start_process: () -> Integer
      def stop_process: () -> Integer
      def restart_process: () -> Integer
      def post_start_process: () -> Thread?
      def notify_transition: (_Transition transition) -> Thread?
    end

    STARTS: Array[Symbol]

    @transitioned: bool
    @triggers: Process::Triggers

    def before_transition: (Process::Transition transition) -> true

    def after_transition: (Process::Transition transition) -> void

    def record_transition: (_Transition transition) -> void
  end

  # The checks that run on a Process every interval, and the events they
  # ask it for
  class Process::Watches
    include Enumerable[ConditionWatch]

    NO_EVENTS: Array[[Symbol, String]]

    attr_reader logger: Logger

    @watches: Array[ConditionWatch]

    def initialize: (logger: Logger) -> void

    def add: (Symbol name, **untyped options) -> Process::Watches

    def <<: (ConditionWatch watch) -> Process::Watches

    def each: () { (ConditionWatch watch) -> void } -> Array[ConditionWatch]

    def clear_history!: () -> void

    # Yields for the process's pid on each due watch's thread
    def run: (Integer now) { () -> Integer? } -> Array[[Symbol, String]]

    private

    def events: (Array[[ConditionWatch, Thread]] threads) -> Array[[Symbol, String]]
  end

  # The triggers a Process tells of its transitions
  class Process::Triggers
    include Enumerable[Trigger]

    attr_reader logger: Logger

    @triggers: Array[Trigger]

    def initialize: (logger: Logger) -> void

    def add: (Class klass, Process process, **untyped options) -> Process::Triggers

    def <<: (Trigger trigger) -> Process::Triggers

    def each: () { (Trigger trigger) -> void } -> Array[Trigger]

    def notify: (_Transition transition) -> Array[Trigger]

    def reset!: () -> Array[Trigger]
  end

  # Carries out the commands a user gives a Process from the command line
  module Process::UserCommands : Process::UserCommands::_Host
    # What UserCommands uses from Process
    interface _Host
      %a{pure} def logger: () -> Logger
      %a{pure} def triggers: () -> Process::Triggers
      def process_running?: (?bool force) -> bool
      def dispatch!: (Symbol event, ?String? reason) -> bool
      def stop_process: () -> Integer
      def restart_process: () -> Integer
    end

    def handle_user_command: (Symbol cmd) -> void

    def user_start: () -> void

    def user_stop: () -> void

    def user_restart: () -> void

    def user_unmonitor: () -> void
  end

  # Keeps a short history of a process's events
  class ProcessStatistics
    type event = [Symbol, String?, Time]

    STRFTIME: String
    EVENTS_TO_PERSIST: Integer

    attr_reader events: Util::RotationalArray[event]

    def initialize: () -> void

    def record_event: (Symbol event, String? reason) -> Util::RotationalArray[event]

    def to_s: () -> String
  end

  # Processes that share a group name. Processes without one are in the
  # group named nil.
  class Group
    attr_accessor name: String?
    attr_accessor processes: Array[Process]
    attr_accessor logger: Logger

    NOBLOCK: Hash[Symbol, Symbol]

    def initialize: (String? name, ?logger: untyped) -> void

    def add_process: (Process process) -> Array[Process]

    def tick: () -> void

    def tick_children: () -> void

    def determine_initial_state: () -> void

    # Proxied events, which return the affected processes as group:process

    def start: (?String? process_name) -> Array[String]

    def unmonitor: (?String? process_name) -> Array[String]

    def stop: (?String? process_name) -> Array[String]

    def restart: (?String? process_name) -> Array[String]

    def status: (?String? process_name) -> Array[String]

    private

    def send_user_command: (Symbol event, String? process_name) -> Array[String]

    def targets: (String? process_name) -> Array[Process]

    def start_user_command: (Process process, Symbol event, bool noblock) -> Thread

    def noblock?: (Process process, Symbol event) -> bool

    def status_line: (Process process, ?String? prefix) -> String

    def add_group_status: (Array[String] lines) -> void

    def add_children_status: (Array[Process] children, String? prefix, Array[String] lines) -> void

    def add_process_status: (String process_name, Array[String] lines) -> void
  end
end
