module Bluepill
  # Warns, once each, about what bluepill 0.3.0 changes
  module Deprecation
    RUBY_REQUIRED: Gem::Version

    self.@warned: Set[String]
    self.@logger: Logger?

    # Warns about a change, unless the same warning was given
    def self.warn: (String message) -> void

    def self.logger: () -> Logger?

    def self.logger=: (Logger? logger) -> void

    # Forgets the warnings given and the logger
    def self.reset!: () -> void

    # Warns when bluepill runs on a Ruby that 0.3.0 doesn't support
    def self.check_ruby: (?String version) -> void

    LIB_DIR: String
    POSITIONAL: Array[Symbol]

    # Warns about what a custom check's class does that 0.3.0 rejects
    def self.check_condition_class: (Class klass) -> void

    # Warns about what a custom trigger's class does that 0.3.0 rejects
    def self.check_trigger_class: (Class klass) -> void

    def self.check_logger: (ProcessConditions::ProcessCondition[untyped] | Trigger check, Logger? logger) -> void

    def self.check_logger_writer: (ProcessConditions::ProcessCondition[untyped] | Trigger check, Thread::Backtrace::Location? location) -> void

    def self.check_trigger_event: (Trigger trigger, untyped event) -> void

    def self.warn_positional_options: (Class klass, String kind, Integer positional) -> void

    def self.warn_check_methods: (Class klass, Class base) -> void

    def self.warn_missing_methods: (Class klass, Class base, bool checks) -> void

    def self.custom?: (UnboundMethod method) -> bool

    def self.positional_options?: (UnboundMethod initialize, Integer positional) -> bool

    CHILD_ATTRIBUTES: Array[Symbol]

    # Warns about a way of setting a process attribute that 0.3.0 removes
    def self.check_attribute: (Symbol name, Symbol key) -> void

    def self.check_monitor_children: (String process_name, Proc? block) -> void

    def self.check_child_stop_command: (String parent_name, Hash[Symbol, untyped] attributes) -> void

    def self.check_daemon_version: (Module | String version) -> void

    APPLICATION_OPTIONS: Array[Symbol]

    # Warns about options passed as a Hash, without **
    def self.check_keywords: (Array[untyped] args, String call) -> void

    def self.check_application_options: (Hash[Symbol, untyped] options) -> void

    def self.check_duplicate_check: (Symbol name) -> void

    EVENTS: Array[Symbol]
    EVENTS_LIST: String
    NO_OPTIONS: Array[Symbol]
    TRIGGER_OPTIONS: Array[Symbol]
    CHECK_OPTIONS: Hash[Symbol, Array[Symbol]]
    REQUIRED_OPTIONS: Hash[Symbol, Array[Symbol]]

    # Warns about the options of a check that 0.3.0 rejects or needs
    def self.check_options: (Symbol | String name, Hash[untyped, untyped] options, Array[Symbol] taken) -> void

    def self.warn_unknown_options: (Symbol check, Array[untyped] unknown) -> void

    def self.warn_missing_options: (Symbol check, Array[Symbol] missing) -> void

    # Warns about a watch's options and events that 0.3.0 rejects
    def self.check_watch: (Symbol | String name, Hash[Symbol, untyped] options, Array[untyped] events) -> void

    def self.check_fires: (Symbol | String name, Array[untyped] events) -> void

    def self.check_on_start_timeout: (String process_name, Hash[Symbol, untyped] attributes) -> void
  end
end
