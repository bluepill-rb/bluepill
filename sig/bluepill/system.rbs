module Bluepill
  # The parts of the daemons gem that bluepill uses
  module Daemonize
    class Error < RuntimeError
    end

    MAX_FD: Integer

    def self.safefork: () -> Integer?

    def self.call_as_daemon: (^() -> void block, ?String? name) -> Integer

    def self.read_daemon_pid: (Integer intermediate, IO reader, IO writer) -> Integer

    def self.run_daemon: (^() -> void block, String? name, IO writer) -> bot

    def self.daemonize: () -> Integer

    def self.detach: () -> Integer

    def self.become_daemon: (?String? name) -> void

    def self.close_io: () -> void

    def self.close_fds: () -> void

    def self.redirect_io: () -> void

    def self.quietly: () { () -> void } -> void
  end

  # Memoizes ps output for a tick, and runs commands as daemons or until
  # they finish
  module System
    extend Ps
    extend Commands
    extend Daemon

    # Options for daemonize and execute_blocking
    type command_options = {
      ?uid: String?,
      ?gid: String?,
      ?working_dir: String?,
      ?environment: Hash[_ToS, _ToS]?,
      ?pid_file: String?,
      ?logger: Logger,
      ?stdin: String?,
      # Hooks are killed after this many seconds
      ?timeout: seconds,
      ?stdout: String?,
      ?stderr: String?,
      ?supplementary_groups: Array[String]?
    }

    type blocking_result = { exit_code: Integer?, stdout: String, stderr: String }

    type grandchild_pipes = { out: [IO, IO], err: [IO, IO], result: IO }

    APPEND_MODE: String

    PS_MUTEX: Thread::Mutex

    NO_PIDS: Array[Integer]

    # Raised when ps could not be run, so there is no data for this tick
    class PsError < StandardError
    end

    # A tick's table of processes, as ps listed them
    class PsTable
      PID: Integer
      PPID: Integer
      PCPU: Integer
      RSS: Integer
      ETIME: Integer
      COMMAND: Integer

      @rows: Hash[Integer, Array[String]]
      @children_by_parent: Hash[Integer, Array[Integer]]?

      def self.parse: (String output) -> PsTable

      attr_reader rows: Hash[Integer, Array[String]]

      def initialize: (Hash[Integer, Array[String]] rows) -> void

      def row: (Integer? pid) -> Array[String]?

      def children: (Integer? pid) -> Array[Integer]

      # The pid must be above 0
      def descendants: (Integer? pid) -> Array[Integer]

      # Adds the column to total, which starts at 0.0
      def sum: (Array[Integer] pids, Integer column, ?Float total) -> Float

      private

      def children_by_parent: () -> Hash[Integer, Array[Integer]]
    end

    # Runs ps once a tick, and reads its table of processes
    module Ps
      # The store lives on System, which extends this module
      @store: Hash[Symbol, PsTable | String]
      # The table get_children read this tick
      @children_table: PsTable?

      def store: () -> Hash[Symbol, PsTable | String]

      def reset_data: () -> void

      def ps_axu: () -> PsTable

      def read_ps_table: () -> (PsTable | String)

      def get_children: (Integer? parent_pid) -> Array[Integer]
    end

    def self.pid_alive?: (Integer pid) -> bool

    def self.started_at: (Integer pid) -> Integer?

    def self.boot_time: () -> Integer?

    def self.cpu_usage: (Integer? pid, boolish include_children) -> Float?

    def self.memory_usage: (Integer? pid, boolish include_children) -> Float?

    def self.usage: (Integer? pid, boolish include_children, Integer column) -> Float?

    def self.running_time: (Integer? pid) -> Integer?

    def self.command: (Integer? pid) -> String?

    def self.delete_if_exists: (String? filename) -> void

    def self.parse_elapsed_time: (String? str) -> Integer

    # Sets up the process that a command runs in
    module CommandSetup
      def setup_command_environment: (command_options options) -> void

      def drop_privileges: (String? uid, String? gid, Array[String]? supplementary_groups) -> void

      def join_groups: (Etc::Passwd? user, Integer? gid_num) -> Integer?

      def add_supplementary_groups: (Array[String]? supplementary_groups) -> void

      def switch_to_user: (Etc::Passwd user) -> void
    end

    # Runs commands in the background, as daemons
    module Daemon
      include CommandSetup

      # Returns the daemon's pid
      def daemonize: (String cmd, ?command_options options) -> Integer?

      def read_daemon_pid: (IO reader, IO writer) -> Integer?

      def start_daemon: (String cmd, command_options options, IO pid_pipe) -> bot

      def daemon_command: (String cmd, command_options options) -> ^() -> void

      def can_write_pid_file: (String pid_file, Logger logger) -> bool

      def redirect_io: (String? io_in, String? io_out, String? io_err) -> void
    end

    # Runs commands until they finish
    module Commands
      include CommandSetup

      def execute_blocking: (String cmd, ?command_options options) -> blocking_result

      def start_blocking_child: (String cmd, command_options options, IO reader, IO result_pipe) -> bot

      def read_blocking_status: (String cmd, seconds? timeout, Integer child, IO reader) -> String

      def kill_group_after: (Integer child, seconds? timeout, String cmd) -> bot

      def run_blocking_child: (String cmd, command_options options, IO result_pipe) -> bot

      def collect_blocking_result: (Integer pid, IO cmd_out_read, IO cmd_err_read) -> blocking_result

      def report_blocking_result: (IO result_pipe, blocking_result result) -> bot

      def exec_blocking_grandchild: (String cmd, command_options options, grandchild_pipes pipes) -> bot

      def reopen_on_pipe: (IO stream, [IO, IO] pipe) -> void

      def report_grandchild_error: (Exception error, grandchild_pipes pipes) -> bot
    end
  end

  # Remembers the pids and process groups of the processes bluepill starts,
  # so it can kill any left over from an earlier run
  module ProcessJournal
    extend Cleanup
    extend Lock

    # What the modules that ProcessJournal extends use from it
    interface _Journal
      def logger: () -> Logger

      def journal_base_dir: () -> String

      def legacy_journal_dir: () -> String

      def pid_journal_filename: (String journal_name, ?String dir) -> String

      def pgid_journal_filename: (String journal_name, ?String dir) -> String

      def journal_entries: (String filename) -> Array[[Integer, Integer?]]

      def pid_journal: (String filename) -> Array[Integer]

      def pgid_journal: (String filename) -> Array[Integer]
    end

    # Kills what an earlier run left in a process's journals
    module Cleanup : _Journal, Lock
      def kill_all_from_journal: (String journal_name) -> void

      def kill_all_pgids_from_journal: (String journal_name) -> void

      def kill_all_pids_from_journal: (String journal_name) -> void

      def journal_dirs: () -> Array[String]

      def kill_all_from_journal_file: (String filename, Array[Integer] ids, String label, Integer sign) -> void

      def term_then_kill_journaled: (Array[Integer] ids, String label, Integer sign) -> void

      def journaled_ids: (String filename, Array[Integer] ids, String label) -> Array[Integer]

      def same_journaled_process?: (Integer id, Integer? journaled, Integer? boot, Integer written) -> bool

      def signal_journaled: (String signal, Array[Integer] ids, String label, Integer sign) -> void
    end

    # Locks a journal while bluepill reads and writes it
    module Lock : _Journal
      def acquire_atomic_fs_lock: [T] (String name) { () -> T } -> T

      def clear_all_atomic_fs_locks: () -> void

      def clear_atomic_fs_lock: (String name) -> void

      def make_atomic_fs_lock: (String lock) -> void

      def wait_for_atomic_fs_lock: (String lock, Integer attempts) -> void
    end

    self.@logger: Logger
    self.@journal_base_dir: String
    self.@legacy_journal_dir: String

    def self.logger: () -> Logger

    def self.journal_base_dir: () -> String

    def self.legacy_journal_dir: () -> String

    # Only the first logger is kept
    def self.logger=: (Logger new_logger) -> Logger

    def self.setup: (String base_dir, _ToS app_name) -> void

    def self.skip_pid?: (Integer? pid) -> bool

    def self.skip_pgid?: (Integer? pgid) -> bool

    def self.pid_journal_filename: (String journal_name, ?String dir) -> String

    def self.pgid_journal_filename: (String journal_name, ?String dir) -> String

    # Each id, with when its process started (nil before 0.2)
    def self.journal_entries: (String filename) -> Array[[Integer, Integer?]]

    def self.journal_line: (Integer id) -> String

    def self.pid_journal: (String filename) -> Array[Integer]

    def self.pgid_journal: (String filename) -> Array[Integer]

    def self.append_pgid_to_journal: (String journal_name, Integer? pgid) -> void

    def self.append_pid_to_journal: (String journal_name, Integer? pid) -> void

    def self.append_process_group_to_journal: (String journal_name, Integer pid) -> void

    def self.append_to_journal: (String filename, String journal_name, String kind, Integer id) { () -> Array[Integer] } -> void
  end
end
